# ความลับที่ใช้ตรวจลายเซ็นคำสั่งจาก Hub (ยาว ≥ 32 ตัว) — ต้องตรงกับที่ใส่ตอนเพิ่มเครื่องใน Hub
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CENTER_AGENT_SECRET=

CENTER_AGENT_PORT=4910
CENTER_AGENT_HOST=0.0.0.0
# รับคำสั่งจาก IP ของเครื่อง Hub เท่านั้น (คั่นด้วย ,) — แนะนำให้ตั้ง
CENTER_AGENT_ALLOW_IPS=

# แจ้งเตือน LINE (ไม่บังคับ) — ใช้ channel/group เดียวกับ DelayHUB ได้
LINE_CHANNEL_ACCESS_TOKEN=
LINE_NOTIFY_TO=

# ถ้า Agent หา npm ไม่เจอ (Windows) ให้ระบุ path ของ npm-cli.js
# NPM_CLI_JS=C:\Program Files\nodejs\node_modules\npm\bin\npm-cli.js
