[
  {
    "id": "delayhub",
    "name": "DelayHUB (PFCM)",
    "repoDir": "I:\\test\\DelayHUB",
    "branch": "main",
    "remote": "origin",
    "ecosystem": "backend/ecosystem.config.js",
    "apps": ["PFCMv2-backend", "PFCMv2-frontend", "rfidc1-service"],
    "singleton": ["rfidc1-service"],
    "ports": [3000, 80],
    "health": [
      { "url": "http://127.0.0.1:3000/health" },
      { "url": "http://127.0.0.1:80/" }
    ],
    "deploy": {
      "mode": "schedule",
      "days": [0],
      "time": "03:00",
      "freeze": [{ "days": [1, 2, 3, 4, 5, 6], "from": "06:00", "to": "20:00" }],
      "install": [
        { "cwd": "backend", "cmd": ["npm", "ci", "--omit=dev"] },
        { "cwd": "frontend", "cmd": ["npm", "ci"] }
      ],
      "build": [{ "cwd": "frontend", "cmd": ["npm", "run", "build"], "timeoutMin": 20 }],
      "test": [],
      "restorePaths": [],
      "reload": "reload",
      "rollback": true,
      "healthTimeoutSec": 90
    }
  },
  {
    "id": "chem-rechub",
    "name": "Chem_RecHUB",
    "repoDir": "E:\\Chem_RecHUB",
    "branch": "main",
    "ecosystem": "ecosystem.config.js",
    "apps": ["chem-rechub"],
    "ports": [4101],
    "health": ["http://127.0.0.1:4101/health"],
    "deploy": { "mode": "immediate", "freeze": [{ "days": [1, 2, 3, 4, 5], "from": "08:00", "to": "17:00" }] }
  },
  {
    "id": "chem-issuehub",
    "name": "Chem_IssueHUB",
    "repoDir": "E:\\Chem_IssueHUB",
    "ecosystem": "ecosystem.config.js",
    "apps": ["chem-issuehub"],
    "ports": [4102],
    "health": ["http://127.0.0.1:4102/health"],
    "deploy": { "mode": "notify" }
  },
  {
    "id": "chem-identifyhub",
    "name": "Chem_IdentifyHUB",
    "repoDir": "E:\\Chem_IdentifyHUB",
    "ecosystem": "ecosystem.config.js",
    "apps": ["chem-identifyhub"],
    "ports": [4103],
    "health": ["http://127.0.0.1:4103/health"],
    "deploy": { "mode": "manual" }
  },
  {
    "id": "qr-ink-hub",
    "name": "QR_Code_Ink_Code_HUB",
    "repoDir": "E:\\QR_Code_Ink_Code_HUB",
    "ecosystem": "ecosystem.config.js",
    "apps": ["qr-code-ink-hub"],
    "ports": [81],
    "health": ["http://127.0.0.1:81/health"],
    "deploy": { "mode": "schedule", "days": [0], "time": "03:30" }
  }
]
